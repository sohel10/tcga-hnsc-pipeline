params {
    project     = "TCGA-HNSC"
    outdir      = "${launchDir}/results"
    padj_cutoff = 0.05
    lfc_cutoff  = 1.0
    top_n_genes = 50
}
process {
    executor = 'local'
    memory   = '8 GB'
    cpus     = 4
}
profiles {
    docker {
        docker.enabled = true
        process.container = 'sohelahmed/tcga-hnsc-pipeline:latest'
    }
    singularity {
        singularity.enabled = true
        process.container = 'docker://sohelahmed/tcga-hnsc-pipeline:latest'
    }
    hpc {
        process {
            executor = 'slurm'
            queue    = 'normal'
            memory   = '16 GB'
            cpus     = 8
            time     = '4h'
        }
    }
}
report {
    enabled = true
    file    = "${params.outdir}/nextflow_report.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/timeline.html"
}
manifest {
    name            = 'tcga-hnsc-pipeline'
    author          = 'Sohel Ahmed, Ph.D.'
    description     = 'TCGA RNA-seq DE pipeline with Bioconductor'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
}
